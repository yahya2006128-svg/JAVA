import java.time.LocalDate;
 import java.util.ArrayList;
import java.util.Collections;
 import java.util.Comparator;
    import java.util.List;

interface Taxable {
     double TAX_RATE = 0.15;
       double calculateTax(); }

interface BonusCalculable {
    double calculateBonus(double performanceScore);}
abstract class Employee implements Comparable<Employee>, Taxable, BonusCalculable {
    private String id;
    private String name;
     protected double baseSalary;
    private LocalDate joinDate;
    public Employee(String id, String name, double baseSalary, LocalDate joinDate) {
        this.id = id;
        this.name = name;
          this.baseSalary = baseSalary;
        this.joinDate = joinDate;}


public abstract double calculateNetSalary();
  @Override
      public double calculateTax() {
        return calculateNetSalary() * TAX_RATE;   }

    @Override
    public int compareTo(Employee other) {
        return Double.compare(other.calculateNetSalary(), this.calculateNetSalary());}
    public String getId() { return id; }
    public String getName() { return name; }
     public double getBaseSalary() { return baseSalary; }
     public LocalDate getJoinDate() { return joinDate; }
    @Override
     public String toString() {
        return "ID: " + id + " | Name: " + name + " | JoinDate: " + joinDate + " | NetSalary: " + calculateNetSalary();
    }
}



class FullTimeEmployee extends Employee {
    private double allowance;
  public FullTimeEmployee(String id, String name, double baseSalary, LocalDate joinDate, double allowance) {
        super(id, name, baseSalary, joinDate);
        this.allowance = allowance; }
 @Override
    public double calculateNetSalary() {
        return baseSalary + allowance;  }
    @Override
    public double calculateBonus(double performanceScore) {
        return baseSalary * 0.10 * performanceScore;}}
class ContractorEmployee extends Employee {
    private int hourlyRate;
    private int hoursWorked;
 public ContractorEmployee(String id, String name, LocalDate joinDate, int hourlyRate, int hoursWorked) {
        super(id, name, 0, joinDate);
        this.hourlyRate = hourlyRate;
        this.hoursWorked = hoursWorked; }
    @Override
    public double calculateNetSalary() {
        return (double) hourlyRate * hoursWorked;
    }
    @Override
    public double calculateBonus(double performanceScore) {
        if (performanceScore > 4.0) {
            return 500.0;
        }
        return 0.0;
    }
}


public class PayrollSystem {
    public static void main(String[] args) {
        List<Employee> employees = new ArrayList<>();
        
        employees.add(new FullTimeEmployee("1", "Ahmed", 5000, LocalDate.of(2020, 3, 15), 1000));
        employees.add(new FullTimeEmployee("2", "Sara", 7000, LocalDate.of(2018, 6, 1), 1500));
        employees.add(new ContractorEmployee("3", "Ali", LocalDate.of(2021, 1, 10), 40, 160));
        employees.add(new ContractorEmployee("4", "Mona", LocalDate.of(2019, 11, 20), 50, 100));

        System.out.println("--- Employees List ---");
        for (Employee e : employees) {
            System.out.println(e);
        }

        Collections.sort(employees);
        System.out.println("\n--- Sorted by Net Salary (Descending) ---");
        for (Employee e : employees) {
            System.out.println(e); }
     employees.sort(Comparator.comparing(Employee::getJoinDate));
         System.out.println("\n--- Sorted by Join Date (Seniority) ---");
          for (Employee e : employees) {
              System.out.println(e);
           double totalTax = 0;
         double totalBonus = 0;
          double score = 4.5;
         for (Employee e : employees) {
              totalTax += e.calculateTax();
               totalBonus += e.calculateBonus(score);
          }

        System.out.println("\n--- Financial Summary ---");
          System.out.println("Total Taaxes " + totalTax);
           System.out.println("Total Bonuses: " + totalBonus);
    }
}
